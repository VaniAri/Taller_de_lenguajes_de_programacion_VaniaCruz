<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagrama UML GameStore Final</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        wine: {
                            light: '#a31536',
                            DEFAULT: '#800020',
                            dark: '#4a0012',
                            glow: '#ff1a53'
                        },
                        dark: {
                            900: '#0a0a0c',
                            800: '#121216',
                            700: '#1a1a20',
                            600: '#252530'
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        code: ['Fira Code', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0a0a0c;
            color: #f0f0f0;
            font-family: 'Poppins', sans-serif;
            overflow-x: hidden;
        }

        /* Glassmorphic cards */
        .glass-card {
            background: rgba(26, 26, 32, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(128, 0, 32, 0.3);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(255, 26, 83, 0.7);
            box-shadow: 0 0 20px rgba(128, 0, 32, 0.6);
        }

        /* UML Class box layout */
        .uml-box {
            font-family: 'Fira Code', monospace;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .uml-box:hover {
            transform: translateY(-4px) scale(1.01);
        }

        .uml-header {
            background: linear-gradient(135deg, #6b0c23 0%, #3b000e 100%);
            border-bottom: 2px solid #ff1a53;
        }

        .uml-badge {
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .uml-badge:hover {
            filter: brightness(1.3);
            transform: scale(1.05);
        }

        .clickable-term {
            cursor: pointer;
            border-bottom: 1px dashed rgba(255, 255, 255, 0.4);
            transition: all 0.2s ease;
            padding: 0 2px;
            border-radius: 2px;
        }

        .clickable-term:hover {
            background: rgba(255, 26, 83, 0.25);
            color: #ff80a0;
            border-bottom-color: #ff1a53;
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a0c;
        }
        ::-webkit-scrollbar-thumb {
            background: #4a0012;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #800020;
        }

        /* Grid lines background effect */
        .bg-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        }

        /* Neon Glows */
        .neon-text-wine {
            text-shadow: 0 0 10px rgba(255, 26, 83, 0.6);
        }

        .active-filter {
            background-color: #800020 !important;
            color: #ffffff !important;
            box-shadow: 0 0 12px rgba(128, 0, 32, 0.8);
            border-color: #ff1a53 !important;
        }

        /* Connection line SVG overlays */
        #svg-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }
    </style>
</head>
<body class="bg-dark-900 min-h-screen text-slate-200 relative bg-grid">

