                            <span class="clickable-term text-[11px] text-rose-300 font-mono block italic" onclick="explainConcept('herencia')">extends ItemTienda</span>
                            <span class="font-bold text-white text-base clickable-term" onclick="explainConcept('ItemPase')">ItemPase</span>
                        </div>
                        <div class="p-3 border-b border-wine/30 text-xs space-y-1.5 bg-dark-800/50">
                            <div class="text-[10px] text-slate-400 uppercase font-sans tracking-wider mb-1 font-semibold">Atributos</div>
                            <div>
                                <span class="text-rose-400 font-bold clickable-term" onclick="explainConcept('private')">-</span> 
                                <span class="text-slate-100 font-semibold">tipoPase</span> : <span class="text-emerald-300">String</span>
                            </div>
                        </div>
                        <div class="p-3 text-xs space-y-1.5 bg-dark-900/40">
                            <div class="text-[10px] text-slate-400 uppercase font-sans tracking-wider mb-1 font-semibold">Métodos</div>
                            <div>
                                <span class="text-emerald-400 font-bold clickable-term" onclick="explainConcept('public')">+</span> 
                                <span class="text-sky-300">getTipoPase</span>() : <span class="text-emerald-300">String</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Segundas Entidades Modelo: Estudiante y Recompensa -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                    
                    <!-- Estudiante Box -->
                    <div id="card-Estudiante" class="uml-box glass-card border-wine/60" data-node="Estudiante">
