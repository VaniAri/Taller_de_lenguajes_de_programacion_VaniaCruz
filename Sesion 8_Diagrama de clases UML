                        Todas
                    </button>
                    <button onclick="filterLayer('modelo')" data-layer="modelo" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-dark-600 bg-dark-800 hover:bg-wine/30 transition text-emerald-400">
                        <i class="fa-solid fa-cubes mr-1"></i> Modelo
                    </button>
                    <button onclick="filterLayer('dao')" data-layer="dao" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-dark-600 bg-dark-800 hover:bg-wine/30 transition text-amber-400">
                        <i class="fa-solid fa-database mr-1"></i> DAO
                    </button>
                    <button onclick="filterLayer('archivos')" data-layer="archivos" class="px-3.5 py-1.5 text-xs font-semibold rounded-lg border border-dark-600 bg-dark-800 hover:bg-wine/30 transition text-sky-400">
