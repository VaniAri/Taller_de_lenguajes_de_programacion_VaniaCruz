                            <div class="text-[10px] text-slate-400 uppercase font-sans tracking-wider mb-1 font-semibold">Atributos</div>
                            <div class="text-slate-300">
                                <span class="text-rose-400 font-bold clickable-term" onclick="explainConcept('private')">-</span> 
                                <span class="text-slate-100 font-semibold">idRecompensa</span> : <span class="text-amber-300">int</span>
                            </div>
                            <div class="text-slate-300">
                                <span class="text-rose-400 font-bold clickable-term" onclick="explainConcept('private')">-</span> 
                                <span class="text-slate-100 font-semibold">nombreItem</span> : <span class="text-emerald-300">String</span>
