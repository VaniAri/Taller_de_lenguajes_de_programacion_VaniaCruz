            <!-- Legend Key -->
            <div class="flex items-center gap-4 text-xs font-mono bg-dark-800/80 px-3 py-1.5 rounded-lg border border-dark-600">
                <div class="flex items-center gap-1.5" title="Público">
                    <span class="text-emerald-400 font-bold">+</span> <span class="clickable-term text-slate-300" onclick="explainConcept('public')">public</span>
                </div>
                <div class="flex items-center gap-1.5" title="Privado">
                    <span class="text-rose-400 font-bold">-</span> <span class="clickable-term text-slate-300" onclick="explainConcept('private')">private</span>
                </div>
                <div class="flex items-center gap-1.5" title="Protegido">
