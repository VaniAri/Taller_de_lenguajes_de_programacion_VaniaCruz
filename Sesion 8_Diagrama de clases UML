                <div class="flex items-center gap-3 mb-4 border-b border-amber-500/30 pb-2">
                    <span class="p-1.5 bg-amber-500/10 text-amber-400 rounded-lg border border-amber-500/20">
                        <i class="fa-solid fa-database"></i>
                    </span>
                    <h2 class="text-lg font-bold text-amber-400 uppercase tracking-wider">
                        Capa DAO <span class="clickable-term text-xs text-slate-400 font-normal lowercase" onclick="explainConcept('dao')">(Data Access Objects - MySQL)</span>
