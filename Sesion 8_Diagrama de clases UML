                            <div>
                                <span class="text-emerald-400 font-bold clickable-term" onclick="explainConcept('public')">+</span> 
                                <span class="text-sky-300">getNombreItem</span>() : <span class="text-emerald-300">String</span>
                            </div>
                            <div>
                                <span class="text-emerald-400 font-bold clickable-term" onclick="explainConcept('public')">+</span> 
                                <span class="text-sky-300">getCostoPuntos</span>() : <span class="text-amber-300">int</span>
                            </div>
                        </div>
                    </div>

                    <!-- ItemAvatar (Hereda de ItemTienda) -->
                    <div id="card-ItemAvatar" class="uml-box glass-card border-wine/60" data-node="ItemAvatar">
                        <div class="uml-header p-3 text-center">
                            <span class="clickable-term text-[11px] text-rose-300 font-mono block italic" onclick="explainConcept('herencia')">extends ItemTienda</span>
