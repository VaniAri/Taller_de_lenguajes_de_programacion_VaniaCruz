                            <div>
                                <span class="text-rose-400 font-bold clickable-term" onclick="explainConcept('private')">-</span> 
                                <span class="text-slate-100 font-semibold">nivelRareza</span> : <span class="text-emerald-300">String</span>
                            </div>
