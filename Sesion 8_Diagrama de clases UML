                    </div>

                    <!-- EstudianteDAO Box -->
                    <div id="card-EstudianteDAO" class="uml-box glass-card border-amber-500/40" data-node="EstudianteDAO">
                        <div class="uml-header p-3 text-center !bg-gradient-to-r !from-amber-900 !to-wine-dark">
                            <span class="clickable-term text-[11px] text-amber-200 font-mono block" onclick="explainConcept('dao')">&lt;&lt;DAO&gt;&gt;</span>
