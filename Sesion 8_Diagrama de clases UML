                <marker id="arrow-inheritance" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#0a0a0c" stroke="#ff1a53" stroke-width="1.5" />
                </marker>
                <!-- Dependency Arrow Head -->
                <marker id="arrow-dependency" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10" fill="none" stroke="#38bdf8" stroke-width="1.5" />
                </marker>
            </defs>
            <g id="svg-lines"></g>
        </svg>

        <!-- LAYERS GRID -->
        <div class="space-y-12 relative z-20">

