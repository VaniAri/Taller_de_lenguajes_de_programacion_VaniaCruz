                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                    <!-- ConexionBD Box -->
                    <div id="card-ConexionBD" class="uml-box glass-card border-amber-500/40" data-node="ConexionBD">
                        <div class="uml-header p-3 text-center !bg-gradient-to-r !from-amber-900 !to-wine-dark">
