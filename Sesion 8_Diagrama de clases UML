                        <div class="p-3 text-xs space-y-1.5 bg-dark-900/40">
                            <div class="text-[10px] text-slate-400 uppercase font-sans tracking-wider mb-1 font-semibold">Métodos</div>
                            <div>
                                <span class="text-emerald-400 font-bold clickable-term" onclick="explainConcept('public')">+</span> 
