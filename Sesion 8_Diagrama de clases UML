        // Filter Layers logic
        function filterLayer(layerName) {
            const buttons = document.querySelectorAll('#filter-buttons button');
            buttons.forEach(btn => {
                if (btn.getAttribute('data-layer') === layerName) {
                    btn.classList.add('active-filter');
                } else {
                    btn.classList.remove('active-filter');
                }
            });

            const sections = document.querySelectorAll('.layer-section');
            sections.forEach(sec => {
                if (layerName === 'all' || sec.getAttribute('data-layer') === layerName) {
                    sec.style.display = 'block';
                } else {
                    sec.style.display = 'none';
                }
            });

            setTimeout(drawConnections, 100);
        }

        function drawConnections() {
            const svgGroup = document.getElementById('svg-lines');
            const svgCanvas = document.getElementById('svg-canvas');
            const container = document.getElementById('diagram-container');
            
            if (!container || !svgGroup) return;

            // Set canvas height to match content
            svgCanvas.setAttribute('height', container.scrollHeight);
            svgCanvas.setAttribute('width', container.scrollWidth);

            svgGroup.innerHTML = ''; // clear

            // Don't draw connections if filtered out
            const activeFilter = document.querySelector('.active-filter')?.getAttribute('data-layer');
            if (activeFilter !== 'all') return;

            // Inheritance relations: ItemAvatar -> ItemTienda & ItemPase -> ItemTienda
            connectCards('card-ItemAvatar', 'card-ItemTienda', 'inheritance');
            connectCards('card-ItemPase', 'card-ItemTienda', 'inheritance');
        }

        function connectCards(fromId, toId, type) {
            const fromElem = document.getElementById(fromId);
            const toElem = document.getElementById(toId);
            const container = document.getElementById('diagram-container');

            if (!fromElem || !toElem) return;

            const cRect = container.getBoundingClientRect();
            const fRect = fromElem.getBoundingClientRect();
            const tRect = toElem.getBoundingClientRect();

            // Calculate anchor points relative to container
            const startX = (fRect.left + fRect.width / 2) - cRect.left;
            const startY = fRect.top - cRect.top;

            const endX = (tRect.left + tRect.width / 2) - cRect.left;
            const endY = (tRect.top + tRect.height) - cRect.top;

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            const midY = (startY + endY) / 2;

            // Curved orthogonal line
            const d = `M ${startX} ${startY} C ${startX} ${midY}, ${endX} ${midY}, ${endX} ${endY}`;
            
            path.setAttribute('d', d);
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke', '#ff1a53');
            path.setAttribute('stroke-width', '2');
            path.setAttribute('stroke-dasharray', '4');
            path.setAttribute('marker-end', 'url(#arrow-inheritance)');

            document.getElementById('svg-lines').appendChild(path);
        }

        // Window events
        window.addEventListener('load', () => {
            drawConnections();
        });

        window.addEventListener('resize', () => {
            drawConnections();
        });

        // Close modal when pressing ESC key
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
